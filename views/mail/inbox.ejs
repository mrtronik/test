             <section class="breadcrumb__before p-relative">
                <div class="breadcrumb__area overflow-hidden position-relative" data-background="assets/imgs/shapes/breadcrumb-shape.png">
                    <div class="breadcrumb__shapes">
                        <div class="breadcrumb__shapes-shape-1"></div>
                        <div class="breadcrumb__shapes-shape-2"></div>
                        <div class="breadcrumb__shapes-shape-3"></div>
                        <div class="breadcrumb__shapes-shape-4"></div>
                        <div class="breadcrumb__shapes-shape-5 upDown">
                            <img src="assets/imgs/shapes/breadcrumb-shape-1.png" alt="img not found">
                        </div>
                        <div class="breadcrumb__shapes-shape-6 line-to-bottom-360">
                            <img src="assets/imgs/shapes/breadcrumb-shape-2.png" alt="img not found">
                        </div>
                        <div class="breadcrumb__shapes-shape-7 line-to-bottom-360-l">
                            <img src="assets/imgs/shapes/breadcrumb-shape-3.png" alt="img not found">
                        </div>
                        <div class="breadcrumb__shapes-shape-8 leftRight">
                            <img src="assets/imgs/shapes/breadcrumb-shape-4.png" alt="img not found">
                        </div>
                        <div class="breadcrumb__shapes-shape-9">
                            <img src="assets/imgs/shapes/breadcrumb-shape-5.png" alt="img not found">
                        </div>
                    </div>
                    <div class="container">
                        <div class="row align-items-center justify-content-between">
                            <div class="col-12">
                                <div class="breadcrumb__content">
                                    <div class="breadcrumb__title-wrapper">
                                        <h1 class="breadcrumb__title"><%= title %></h1>
                                    </div>
                                    <div class="breadcrumb__menu">
                                        <nav>
                                            <ul>
                                                <li><span><a href="/dashboard"> <img src="assets/imgs/icon/home-icon.png" alt="img not found">Home</a></span></li>
                                                <li class="active"><span> <%= title %></span></li>
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
             </section>
<section class="about__area section-space-top section-space-bottom-1">
                <div class="container">

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Inbox</h4>
    <a href="/mail/compose" class="btn btn-primary"><i class="ri-mail-send-fill"></i> Compose</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:25%">From</th>
                        <th style="width:50%">Subject</th>
                        <th style="width:25%">Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (emails && emails.length > 0) { %>
                        <% emails.forEach(function(mail) { %>
                            <tr>
                                <td><strong><%= mail.name || mail.from %></strong></td>
                                <td>
                                    <a href="/mail/email/<%= mail.uid %>" class="text-decoration-none">
                                        <%= mail.subject %>
                                    </a>
                                </td>
                                <td class="text-muted"><%= mail.date %></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">No emails found</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

    </div>
</section>
