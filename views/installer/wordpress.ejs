<section class="breadcrumb__before p-relative">
    <div class="breadcrumb__area overflow-hidden position-relative" data-background="assets/imgs/shapes/breadcrumb-shape.png">
        <div class="breadcrumb__shapes">
            <div class="breadcrumb__shapes-shape-1"></div>
            <div class="breadcrumb__shapes-shape-2"></div>
            <div class="breadcrumb__shapes-shape-3"></div>
            <div class="breadcrumb__shapes-shape-4"></div>
            <div class="breadcrumb__shapes-shape-5 upDown">
                <img src="assets/imgs/shapes/breadcrumb-shape-1.png" alt="img not found">
            </div>
            <div class="breadcrumb__shapes-shape-6 line-to-bottom-360">
                <img src="assets/imgs/shapes/breadcrumb-shape-2.png" alt="img not found">
            </div>
            <div class="breadcrumb__shapes-shape-7 line-to-bottom-360-l">
                <img src="assets/imgs/shapes/breadcrumb-shape-3.png" alt="img not found">
            </div>
            <div class="breadcrumb__shapes-shape-8 leftRight">
                <img src="assets/imgs/shapes/breadcrumb-shape-4.png" alt="img not found">
            </div>
            <div class="breadcrumb__shapes-shape-9">
                <img src="assets/imgs/shapes/breadcrumb-shape-5.png" alt="img not found">
            </div>
        </div>
        <div class="container">
            <div class="row align-items-center justify-content-between">
                <div class="col-12">
                    <div class="breadcrumb__content">
                        <div class="breadcrumb__title-wrapper">
                            <h1 class="breadcrumb__title"><%= title %></h1>
                        </div>
                        <div class="breadcrumb__menu">
                            <nav>
                                <ul>
                                    <li><span><a href="/dashboard"> <img src="assets/imgs/icon/home-icon.png" alt="img not found">Home</a></span></li>
                                    <li class="active"><span><%= title %></span></li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="about__area section-space-top section-space-bottom-1">
    <div class="container">

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3"><i class="ri-wordpress-fill"></i> Install WordPress</h5>

                        <form id="wpInstallForm">
                            <div class="mb-3">
                                <label class="form-label">Select Domain <span class="text-danger">*</span></label>
                                <select class="form-select" id="wpDomain" required>
                                    <option value="">-- Pilih Domain --</option>
                                    <% if (websites.length === 0) { %>
                                        <option value="" disabled>No websites found</option>
                                    <% } else { %>
                                        <% websites.forEach(function(site) { %>
                                            <option value="<%= site.domain %>"
                                                data-installed="<%= site.wpInstalled %>"
                                                data-version="<%= site.wpVersion || '' %>"
                                                data-docroot="<%= site.document_root || '/home/public_html/' + site.domain %>">
                                                <%= site.domain %>
                                                <% if (site.wpInstalled) { %> (WP <%= site.wpVersion %>)<% } %>
                                            </option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>

                            <div id="wpStatus" class="mb-3" style="display:none;">
                                <div class="alert alert-warning mb-0">
                                    <i class="ri-alert-line"></i> <span id="wpStatusText"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Site Title <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="wpSiteName" required placeholder="My Website">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Admin Username <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="wpAdminUser" required placeholder="admin">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Admin Password <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input type="password" class="form-control" id="wpAdminPassword" required>
                                        <button class="btn btn-outline-secondary" type="button" onclick="generatePassword()">
                                            <i class="ri-refresh-line"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Admin Email <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control" id="wpAdminEmail" required placeholder="admin@example.com">
                                </div>
                            </div>

                            <hr>

                            <h6 class="mb-2">Database (Optional)</h6>
                            <p class="text-muted mb-3">Kosongkan untuk auto-create</p>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">DB Name</label>
                                    <input type="text" class="form-control" id="wpDbName" placeholder="wp_domain_com">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">DB User</label>
                                    <input type="text" class="form-control" id="wpDbUser" placeholder="Same as DB name">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">DB Password</label>
                                    <input type="text" class="form-control" id="wpDbPassword" placeholder="Auto-generated">
                                </div>
                            </div>

                            <div class="alert alert-light border d-flex align-items-center mb-3">
                                <i class="ri-shield-check-fill text-success fs-5 me-2"></i>
                                <div>
                                    <strong>MR Panel Cache</strong> auto-installed
                                    <br><small class="text-muted">Page Cache + Browser Cache + OPcache</small>
                                </div>
                            </div>

                            <div class="text-end">
                                <button type="submit" class="btn btn-primary" id="btnInstall">
                                    <i class="ri-download-line"></i> Install WordPress
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Installed</h5>
                        <% let hasInstalled = false; %>
                        <% websites.forEach(function(site) { %>
                            <% if (site.wpInstalled) { %>
                                <% hasInstalled = true; %>
                                <div class="d-flex align-items-center mb-2 p-2 border rounded">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0"><%= site.domain %></h6>
                                        <small class="text-muted">WP <%= site.wpVersion %></small>
                                    </div>
                                    <div>
                                        <a href="http://<%= site.domain %>/wp-admin" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="ri-external-link-line"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteWp('<%= site.domain %>')">
                                            <i class="ri-delete-bin-line"></i>
                                        </button>
                                    </div>
                                </div>
                            <% } %>
                        <% }); %>
                        <% if (!hasInstalled) { %>
                            <div class="text-center text-muted py-3">
                                <i class="ri-wordpress-fill fs-1"></i>
                                <p class="mt-2 mb-0">Belum ada WordPress</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script>
document.getElementById('wpDomain').addEventListener('change', function() {
    const opt = this.options[this.selectedIndex];
    const installed = opt.dataset.installed === 'true';
    const status = document.getElementById('wpStatus');
    const statusText = document.getElementById('wpStatusText');

    if (installed) {
        status.style.display = 'block';
        statusText.innerHTML = 'WordPress sudah terinstall (v' + opt.dataset.version + '). Reinstall akan overwrite.';
    } else {
        status.style.display = 'none';
    }

    const domain = this.value;
    if (domain) {
        document.getElementById('wpDbName').placeholder = 'wp_' + domain.replace(/\./g, '_');
    }
});

document.getElementById('wpInstallForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const domain = document.getElementById('wpDomain').value;
    if (!domain) return Swal.fire('Error', 'Pilih domain', 'error');

    const btn = document.getElementById('btnInstall');
    btn.disabled = true;
    btn.innerHTML = '<i class="ri-loader-4-line ri-spin"></i> Installing...';

    try {
        const res = await fetch('/api/installer/wordpress/install', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                domain,
                siteName: document.getElementById('wpSiteName').value,
                adminUser: document.getElementById('wpAdminUser').value,
                adminPassword: document.getElementById('wpAdminPassword').value,
                adminEmail: document.getElementById('wpAdminEmail').value,
                dbName: document.getElementById('wpDbName').value || undefined,
                dbUser: document.getElementById('wpDbUser').value || undefined,
                dbPassword: document.getElementById('wpDbPassword').value || undefined
            })
        });

        const data = await res.json();

        if (data.error) {
            Swal.fire('Error', data.error, 'error');
        } else {
            let msg = '<div class="text-start">';
            msg += '<b>WordPress installed!</b><hr class="my-2">';
            msg += '<b>Admin URL:</b> <a href="http://' + domain + '/wp-admin" target="_blank">' + domain + '/wp-admin</a><br>';
            msg += '<b>Username:</b> ' + document.getElementById('wpAdminUser').value + '<br>';
            msg += '<b>Password:</b> ' + document.getElementById('wpAdminPassword').value;
            if (data.db) {
                msg += '<hr class="my-2"><small class="text-muted">DB: ' + data.db.name + ' | User: ' + data.db.user + '</small>';
            }
            if (data.cache && data.cache.installed) {
                msg += '<hr class="my-2"><span class="text-success"><i class="ri-check-line"></i> MR Panel Cache: Active</span>';
            }
            msg += '</div>';

            Swal.fire({
                title: 'Berhasil!',
                html: msg,
                icon: 'success',
                width: 500,
                confirmButtonText: 'Buka Admin',
                showCancelButton: true,
                cancelButtonText: 'Tutup'
            }).then((result) => {
                if (result.isConfirmed) window.open('http://' + domain + '/wp-admin', '_blank');
                location.reload();
            });
        }
    } catch (err) {
        Swal.fire('Error', err.message, 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="ri-download-line"></i> Install WordPress';
    }
});

function generatePassword() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%';
    let pass = '';
    for (let i = 0; i < 16; i++) pass += chars.charAt(Math.floor(Math.random() * chars.length));
    document.getElementById('wpAdminPassword').value = pass;
}

async function deleteWp(domain) {
    const result = await Swal.fire({
        title: 'Hapus WordPress?',
        text: 'Semua file WordPress di ' + domain + ' akan dihapus',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'Ya, hapus'
    });

    if (result.isConfirmed) {
        try {
            const res = await fetch('/api/installer/wordpress/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ domain })
            });
            const data = await res.json();
            if (data.error) {
                Swal.fire('Error', data.error, 'error');
            } else {
                Swal.fire('Deleted!', 'WordPress dihapus.', 'success').then(() => location.reload());
            }
        } catch (err) {
            Swal.fire('Error', err.message, 'error');
        }
    }
}
</script>
