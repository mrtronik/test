<div class="content-page">
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h4 class="page-title"><i class="ri-code-line"></i> Laravel Installer</h4>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Install Laravel</h5>

                            <form id="laravelInstallForm">
                                <div class="mb-3">
                                    <label class="form-label">Select Domain <span class="text-danger">*</span></label>
                                    <select class="form-select" id="lvDomain" required>
                                        <option value="">-- Pilih Domain --</option>
                                        <% if (websites.length === 0) { %>
                                            <option value="" disabled>No websites found</option>
                                        <% } else { %>
                                            <% websites.forEach(function(site) { %>
                                                <option value="<%= site.domain %>"
                                                    data-installed="<%= site.laravelInstalled %>"
                                                    data-version="<%= site.laravelVersion || '' %>">
                                                    <%= site.domain %>
                                                    <% if (site.laravelInstalled) { %>
                                                        <span class="badge bg-success">Laravel</span>
                                                    <% } %>
                                                </option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                </div>

                                <div id="lvStatus" class="mb-3" style="display:none;">
                                    <div class="alert alert-info">
                                        <i class="ri-information-line"></i>
                                        <span id="lvStatusText"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">App Name</label>
                                        <input type="text" class="form-control" id="lvAppName" placeholder="My Laravel App" value="Laravel">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Git Repository (Optional)</label>
                                        <input type="text" class="form-control" id="lvRepoUrl" placeholder="https://github.com/user/repo.git">
                                        <small class="text-muted">Default: official Laravel repo</small>
                                    </div>
                                </div>

                                <hr>

                                <h6 class="mb-3">Database Configuration</h6>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Database Name</label>
                                        <input type="text" class="form-control" id="lvDbName" placeholder="Auto: laravel_domain_com">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Database User</label>
                                        <input type="text" class="form-control" id="lvDbUser" placeholder="Same as DB name">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Database Password</label>
                                        <input type="text" class="form-control" id="lvDbPassword" placeholder="Auto-generated">
                                    </div>
                                </div>

                                <div class="text-end">
                                    <button type="submit" class="btn btn-primary" id="btnInstallLv">
                                        <i class="ri-download-line"></i> Install Laravel
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Installed Laravel</h5>
                            <div id="installedListLv">
                                <% let hasInstalled = false; %>
                                <% websites.forEach(function(site) { %>
                                    <% if (site.laravelInstalled) { %>
                                        <% hasInstalled = true; %>
                                        <div class="d-flex align-items-center mb-3 p-2 border rounded">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-0"><%= site.domain %></h6>
                                                <small class="text-muted"><%= site.laravelVersion %></small>
                                            </div>
                                            <div>
                                                <a href="http://<%= site.domain %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                                    <i class="ri-external-link-line"></i>
                                                </a>
                                                <button class="btn btn-sm btn-outline-info" onclick="clearCacheLv('<%= site.domain %>')">
                                                    <i class="ri-refresh-line"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" onclick="deleteLv('<%= site.domain %>')">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </div>
                                        </div>
                                    <% } %>
                                <% }); %>
                                <% if (!hasInstalled) { %>
                                    <div class="text-center text-muted py-4">
                                        <i class="ri-code-line fs-1"></i>
                                        <p class="mt-2">No Laravel installed yet</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('lvDomain').addEventListener('change', function() {
    const opt = this.options[this.selectedIndex];
    const installed = opt.dataset.installed === 'true';
    const status = document.getElementById('lvStatus');
    const statusText = document.getElementById('lvStatusText');
    
    if (installed) {
        status.style.display = 'block';
        status.className = 'mb-3 alert alert-warning';
        statusText.innerHTML = '<i class="ri-alert-line"></i> Laravel is already installed (' + opt.dataset.version + '). Reinstalling will overwrite files.';
    } else {
        status.style.display = 'none';
    }
    
    const domain = this.value;
    if (domain) {
        document.getElementById('lvDbName').placeholder = 'laravel_' + domain.replace(/\./g, '_');
    }
});

document.getElementById('laravelInstallForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const domain = document.getElementById('lvDomain').value;
    if (!domain) return Swal.fire('Error', 'Please select a domain', 'error');
    
    const btn = document.getElementById('btnInstallLv');
    btn.disabled = true;
    btn.innerHTML = '<i class="ri-loader-4-line ri-spin"></i> Installing... (may take a while)';
    
    try {
        const res = await fetch('/api/installer/laravel/install', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                domain,
                appName: document.getElementById('lvAppName').value,
                dbName: document.getElementById('lvDbName').value || undefined,
                dbUser: document.getElementById('lvDbUser').value || undefined,
                dbPassword: document.getElementById('lvDbPassword').value || undefined,
                repoUrl: document.getElementById('lvRepoUrl').value || undefined
            })
        });
        
        const data = await res.json();
        
        if (data.error) {
            Swal.fire('Error', data.error, 'error');
        } else {
            let msg = 'Laravel installed successfully!';
            if (data.db) {
                msg += '<br><br><b>Database:</b> ' + data.db.name;
                msg += '<br><b>DB User:</b> ' + data.db.user;
                msg += '<br><b>DB Password:</b> ' + data.db.password;
            }
            
            
            Swal.fire({ title: 'Success!', html: msg, icon: 'success', confirmButtonText: 'OK' })
                .then(() => location.reload());
        }
    } catch (err) {
        Swal.fire('Error', err.message, 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="ri-download-line"></i> Install Laravel';
    }
});

async function deleteLv(domain) {
    const result = await Swal.fire({
        title: 'Delete Laravel?',
        text: 'This will delete all Laravel files from ' + domain,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'Yes, delete'
    });
    
    if (result.isConfirmed) {
        try {
            const res = await fetch('/api/installer/laravel/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ domain })
            });
            const data = await res.json();
            if (data.error) Swal.fire('Error', data.error, 'error');
            else Swal.fire('Deleted!', 'Laravel has been removed.', 'success').then(() => location.reload());
        } catch (err) {
            Swal.fire('Error', err.message, 'error');
        }
    }
}

async function clearCacheLv(domain) {
    try {
        const res = await fetch('/api/installer/laravel/clear-cache', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ domain })
        });
        const data = await res.json();
        if (data.error) Swal.fire('Error', data.error, 'error');
        else Swal.fire('Success', 'Cache cleared!', 'success');
    } catch (err) {
        Swal.fire('Error', err.message, 'error');
    }
}
</script>
