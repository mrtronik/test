 <%- include('../partials/page-header', {
    title: 'Web Terminal',
    breadcrumb: [
        { text: 'Web Terminal', url: '/terminal' }
    ],
    buttons: [
        {
            text: 'Back',
            url: '/dashboard',
            icon: 'fas fa-arrow-left',
            color: 'gray'
        }
    ]
}) %>

<div class="content" style="padding: 0;">
    <div class="container-fluid" style="padding: 0; height: calc(100vh - 60px);">
        
        <div style="background: #1e1e1e; color: #fff; padding: 8px 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #333;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-terminal" style="color: #51cf66;"></i>
                <span style="font-weight: 600;">Web Terminal</span>
                <span id="terminal-status" class="badge bg-secondary">Connecting...</span>
            </div>
            <div style="display: flex; gap: 8px;">
                <button id="btn-reconnect" class="btn btn-sm btn-outline-light" onclick="reconnectTerminal()">
                    <i class="fas fa-redo"></i> Reconnect
                </button>
            </div>
        </div>

        <div id="terminal-container" style="height: calc(100% - 45px); background: #1e1e1e;"></div>

    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.min.css">
<script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xterm-addon-web-links@0.9.0/lib/xterm-addon-web-links.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
var term = null;
var socket = null;
var fitAddon = null;

function initTerminal() {
    term = new Terminal({
        theme: {
            background: '#1e1e1e',
            foreground: '#d4d4d4',
            cursor: '#d4d4d4',
            cursorAccent: '#1e1e1e',
            selectionBackground: '#264f78',
            black: '#1e1e1e',
            red: '#f44747',
            green: '#6a9955',
            yellow: '#dcdcaa',
            blue: '#569cd6',
            magenta: '#c586c0',
            cyan: '#4ec9b0',
            white: '#d4d4d4',
            brightBlack: '#808080',
            brightRed: '#f44747',
            brightGreen: '#6a9955',
            brightYellow: '#dcdcaa',
            brightBlue: '#569cd6',
            brightMagenta: '#c586c0',
            brightCyan: '#4ec9b0',
            brightWhite: '#ffffff'
        },
        fontFamily: '"Cascadia Code", "Fira Code", "JetBrains Mono", Menlo, Monaco, "Courier New", monospace',
        fontSize: 14,
        lineHeight: 1.2,
        cursorBlink: true,
        cursorStyle: 'bar',
        allowTransparency: true,
        scrollback: 5000
    });

    fitAddon = new FitAddon.FitAddon();
    var webLinksAddon = new WebLinksAddon.WebLinksAddon();

    term.loadAddon(fitAddon);
    term.loadAddon(webLinksAddon);

    term.open(document.getElementById('terminal-container'));

    setTimeout(function() {
        fitAddon.fit();
    }, 100);

    term.onData(function(data) {
        if (socket && socket.connected) {
            socket.emit('terminal:data', data);
        }
    });

    window.addEventListener('resize', function() {
        if (fitAddon) {
            fitAddon.fit();
        }
    });

    new ResizeObserver(function() {
        if (fitAddon) {
            fitAddon.fit();
        }
    }).observe(document.getElementById('terminal-container'));
}

function connectSocket() {
    socket = io();

    socket.on('connect', function() {
        document.getElementById('terminal-status').className = 'badge bg-warning';
        document.getElementById('terminal-status').textContent = 'Connecting...';
        socket.emit('terminal:create');
    });

    socket.on('terminal:created', function(data) {
        document.getElementById('terminal-status').className = 'badge bg-success';
        document.getElementById('terminal-status').textContent = 'Connected (' + data.shell + ')';
        term.focus();
    });

    socket.on('terminal:data', function(data) {
        term.write(data);
    });

    socket.on('terminal:exit', function(data) {
        document.getElementById('terminal-status').className = 'badge bg-danger';
        document.getElementById('terminal-status').textContent = 'Disconnected (exit: ' + data.exitCode + ')';
    });

    socket.on('disconnect', function() {
        document.getElementById('terminal-status').className = 'badge bg-danger';
        document.getElementById('terminal-status').textContent = 'Disconnected';
    });
}

function reconnectTerminal() {
    if (socket) {
        socket.disconnect();
    }
    term.clear();
    connectSocket();
}

var observer = new ResizeObserver(function() {
    if (fitAddon) {
        setTimeout(function() {
            fitAddon.fit();
            if (socket && socket.connected) {
                socket.emit('terminal:resize', { cols: term.cols, rows: term.rows });
            }
        }, 100);
    }
});

document.addEventListener('DOMContentLoaded', function() {
    initTerminal();
    connectSocket();

    observer.observe(document.getElementById('terminal-container'));

    term.onResize(function(size) {
        if (socket && socket.connected) {
            socket.emit('terminal:resize', { cols: size.cols, rows: size.rows });
        }
    });
});
</script>
