<section class="about__area section-space-top section-space-bottom-1">
                <div class="container">

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">PHP Manager</h4>
        <small class="text-muted">PHP configuration and modules</small>
    </div>
    <button class="btn btn-warning" onclick="restartPhp()"><i class="ri-refresh-line"></i> Restart PHP-FPM</button>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body text-center">
                <i class="ri-code-s-slash-line fs-1 text-primary"></i>
                <h5 class="mt-2"><%= version %></h5>
                <span class="badge <%= serviceStatus.running ? 'bg-success' : 'bg-danger' %>">
                    PHP-FPM: <%= serviceStatus.running ? 'Running' : 'Stopped' %>
                </span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h6>PHP-FPM Version</h6>
                <p class="mb-0"><%= fpmVersion || 'Not installed' %></p>
                <% if (fpmVersion) { %>
                    <small class="text-muted">Config: /etc/php/<%= fpmVersion %>/fpm/</small>
                <% } %>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h6>php.ini Location</h6>
                <p class="mb-0" style="word-break:break-all"><small><%= iniPath || 'Not found' %></small></p>
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs" id="phpTab" role="tablist">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#tabSettings">Key Settings</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tabModules">Modules (<%= modules.length %>)</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tabInstalled">Installed Versions</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tabOpCache">OPcache</a>
    </li>
</ul>

<div class="tab-content border border-top-0 rounded-bottom p-3 bg-white">
    <div class="tab-pane fade show active" id="tabSettings">
        <h6>Key PHP Settings</h6>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr><th style="width:40%">Setting</th><th>Value</th></tr>
                </thead>
                <tbody>
                    <% const settingLabels = {
                        'memory_limit': 'Memory Limit',
                        'upload_max_filesize': 'Upload Max Filesize',
                        'post_max_size': 'Post Max Size',
                        'max_execution_time': 'Max Execution Time',
                        'max_input_time': 'Max Input Time',
                        'max_file_uploads': 'Max File Uploads',
                        'display_errors': 'Display Errors',
                        'error_reporting': 'Error Reporting',
                        'date.timezone': 'Timezone',
                        'session.auto_start': 'Session Auto Start',
                        'session.cookie_lifetime': 'Session Cookie Lifetime',
                        'session.gc_maxlifetime': 'Session GC Max Lifetime'
                    }; %>
                    <% Object.entries(settingLabels).forEach(function([key, label]) { %>
                        <tr>
                            <td><strong><%= label %></strong><br><small class="text-muted"><%= key %></small></td>
                            <td><code><%= iniSettings[key] || 'default' %></code></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="tab-pane fade" id="tabModules">
        <h6>Loaded Modules</h6>
        <div class="row">
            <% modules.forEach(function(mod) { %>
                <div class="col-md-3 col-sm-4 mb-2">
                    <span class="badge bg-light text-dark border p-2 w-100 text-start"><i class="ri-checkbox-circle-fill text-success"></i> <%= mod %></span>
                </div>
            <% }); %>
        </div>
    </div>

    <div class="tab-pane fade" id="tabInstalled">
        <h6>Installed PHP Versions</h6>
        <% if (installedVersions.length > 0) { %>
            <div class="list-group">
                <% installedVersions.forEach(function(v) { %>
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>PHP <%= v %></strong>
                            <% if (v === fpmVersion) { %>
                                <span class="badge bg-success ms-2">Active FPM</span>
                            <% } %>
                        </div>
                        <small class="text-muted">/etc/php/<%= v %>/</small>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p class="text-muted">No PHP versions found in /etc/php/</p>
        <% } %>
    </div>

    <div class="tab-pane fade" id="tabOpCache">
        <h6>OPcache Status</h6>
        <% if (opcache) { %>
            <div class="row">
                <div class="col-md-6">
                    <table class="table table-hover">
                        <tr><td>Enabled</td><td><span class="badge bg-<%= opcache.opcache_enabled ? 'success' : 'danger' %>"><%= opcache.opcache_enabled ? 'Yes' : 'No' %></span></td></tr>
                        <tr><td>Memory Usage</td><td><%= opcache.memory_usage ? (opcache.memory_usage.used_memory / 1024 / 1024).toFixed(2) + ' MB' : 'N/A' %></td></tr>
                        <tr><td>Memory Free</td><td><%= opcache.memory_usage ? (opcache.memory_usage.free_memory / 1024 / 1024).toFixed(2) + ' MB' : 'N/A' %></td></tr>
                        <tr><td>Buffer Size</td><td><%= opcache.memory_usage ? (opcache.memory_usage.buffer_size / 1024 / 1024).toFixed(2) + ' MB' : 'N/A' %></td></tr>
                    </table>
                </div>
                <div class="col-md-6">
                    <table class="table table-hover">
                        <tr><td>Hits</td><td><%= opcache.opcache_statistics ? opcache.opcache_statistics.hits.toLocaleString() : 'N/A' %></td></tr>
                        <tr><td>Misses</td><td><%= opcache.opcache_statistics ? opcache.opcache_statistics.misses.toLocaleString() : 'N/A' %></td></tr>
                        <tr><td>Hit Rate</td><td><%= opcache.opcache_statistics ? (opcache.opcache_statistics.opcache_hit_rate * 100).toFixed(2) + '%' : 'N/A' %></td></tr>
                        <tr><td>Scripts</td><td><%= opcache.opcache_statistics ? opcache.opcache_statistics.num_cached_scripts : 'N/A' %></td></tr>
                    </table>
                </div>
            </div>
        <% } else { %>
            <p class="text-muted">OPcache info not available</p>
        <% } %>
    </div>
</div>

    </div>
</section>

<script>
function restartPhp() {
    Swal.fire({
        title: 'Restart PHP-FPM?',
        text: 'This will briefly interrupt PHP processing.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        confirmButtonText: 'Yes, restart'
    }).then(result => {
        if (result.isConfirmed) {
            fetch('/api/php/restart', { method: 'POST' })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({ icon: 'success', title: 'PHP-FPM restarted', timer: 1500, showConfirmButton: false })
                            .then(() => window.location.reload());
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: data.error });
                    }
                })
                .catch(err => Swal.fire({ icon: 'error', title: 'Error', text: err.message }));
        }
    });
}
</script>
