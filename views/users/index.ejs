<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box justify-content-between d-flex align-items-lg-center flex-lg-row flex-column">
                    <h4 class="page-title"><i class="ri-user-line me-2"></i>User Management</h4>
                    <div>
                        <a href="/users/add" class="btn btn-success btn-sm">
                            <i class="ri-user-add-line me-1"></i>Add User
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-centered mb-0">
                                <thead class="bg-light-subtle">
                                    <tr>
                                        <th>Name</th>
                                        <th>Username</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Package</th>
                                        <th>Status</th>
                                        <th>Last Login</th>
                                        <th style="width: 120px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% users.forEach(function(u) { %>
                                    <tr>
                                        <td><strong><%= u.name %></strong></td>
                                        <td><%= u.username %></td>
                                        <td><%= u.email %></td>
                                        <td>
                                            <% if (u.role === 'admin') { %>
                                            <span class="badge bg-danger text-white">Admin</span>
                                            <% } else if (u.role === 'reseller') { %>
                                            <span class="badge bg-primary text-white">Reseller</span>
                                            <% } else { %>
                                            <span class="badge bg-info text-white">User</span>
                                            <% } %>
                                        </td>
                                        <td><%= u.package_name || '-' %></td>
                                        <td>
                                            <% if (u.status === 'active') { %>
                                            <span class="badge bg-success text-white">Active</span>
                                            <% } else { %>
                                            <span class="badge bg-warning text-dark"><%= u.status %></span>
                                            <% } %>
                                        </td>
                                        <td class="text-muted"><%= u.last_login ? new Date(u.last_login).toLocaleDateString() : 'Never' %></td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="/users/<%= u.id %>/edit" class="btn btn-light" title="Edit"><i class="ri-edit-line"></i></a>
                                                <% if (u.status === 'active' && u.role !== 'admin') { %>
                                                <form action="/users/<%= u.id %>/suspend" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-light text-warning" title="Suspend"><i class="ri-pause-circle-line"></i></button>
                                                </form>
                                                <% } else if (u.status === 'suspended') { %>
                                                <form action="/users/<%= u.id %>/activate" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-light text-success" title="Activate"><i class="ri-play-circle-line"></i></button>
                                                </form>
                                                <% } %>
                                                <% if (u.role !== 'admin') { %>
                                                <form action="/users/<%= u.id %>/delete" method="POST" class="d-inline" onsubmit="event.preventDefault(); confirmDelete(this, 'Delete this user?')">
                                                    <button type="submit" class="btn btn-light text-danger" title="Delete"><i class="ri-delete-bin-line"></i></button>
                                                </form>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
