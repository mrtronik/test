<%- include('../partials/page-header', {
    title: 'Website',
    breadcrumb: [
        { text: 'Website', url: '/websites' }
    ],
    buttons: [
        {
            text: 'Back',
            url: '/dashboard',
            icon: 'fas fa-arrow-left',
            color: 'gray'
        }
    ]
}) %>
 <div class="bg-white rounded-lg border border-gray-200 shadow-sm">
    <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
        <h6 class="font-semibold text-gray-800">Websites</h6>
        <a href="/websites/add" class="text-sm bg-blue-600 text-white px-3 py-1.5 rounded hover:bg-blue-700 no-underline">
            <i class="ri-add-line mr-1"></i> Add Website
        </a>
    </div>

    <!-- ✅ MOBILE TABLE: Domain + Status + Actions -->
    <div class="block md:hidden">
        <table class="w-full text-sm">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-3 py-2.5 text-left text-xs font-semibold text-gray-600">Domain</th>
                    <th class="px-3 py-2.5 text-left text-xs font-semibold text-gray-600">Status</th>
                    <th class="px-3 py-2.5 text-right text-xs font-semibold text-gray-600">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% websites.forEach(function(site) { %>
                <tr class="border-b border-gray-100 hover:bg-gray-50">
                    <td class="px-3 py-2.5">
                        <a href="/websites/<%= site.id %>" class="font-semibold text-blue-600 hover:text-blue-800 no-underline">
                            <i class="ri-global-line text-blue-500 mr-1"></i> <%= site.domain %>
                        </a>
                    </td>
                    <td class="px-3 py-2.5">
                        <% if (site.status === 'active') { %>
                            <span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded-full"><i class="ri-checkbox-blank-circle-fill mr-1"></i>Active</span>
                        <% } else if (site.status === 'suspended') { %>
                            <span class="bg-yellow-100 text-yellow-700 text-xs font-medium px-2 py-0.5 rounded-full"><i class="ri-checkbox-blank-circle-fill mr-1"></i>Suspend</span>
                        <% } else { %>
                            <span class="bg-gray-100 text-gray-700 text-xs font-medium px-2 py-0.5 rounded-full"><i class="ri-checkbox-blank-circle-fill mr-1"></i>Pending</span>
                        <% } %>
                    </td>
                    <td class="px-3 py-2.5 text-right whitespace-nowrap">
                        <a href="/websites/<%= site.id %>" class="inline-flex items-center justify-center w-7 h-7 border border-blue-300 text-blue-600 rounded hover:bg-blue-50"><i class="ri-settings-3-line text-sm"></i></a>
                        <% if (site.status === 'active') { %>
                        <form action="/websites/<%= site.id %>/suspend" method="POST" class="inline">
                            <button class="inline-flex items-center justify-center w-7 h-7 border border-yellow-300 text-yellow-600 rounded hover:bg-yellow-50" onclick="event.preventDefault(); confirmDelete(this.closest('form'), 'Suspend this website?')"><i class="ri-pause-line text-sm"></i></button>
                        </form>
                        <% } else { %>
                        <form action="/websites/<%= site.id %>/activate" method="POST" class="inline">
                            <button class="inline-flex items-center justify-center w-7 h-7 border border-green-300 text-green-600 rounded hover:bg-green-50"><i class="ri-play-line text-sm"></i></button>
                        </form>
                        <% } %>
                        <form action="/websites/<%= site.id %>/delete" method="POST" class="inline">
                            <button class="inline-flex items-center justify-center w-7 h-7 border border-red-300 text-red-600 rounded hover:bg-red-50" onclick="event.preventDefault(); confirmDelete(this.closest('form'), 'Delete this website? This cannot be undone.')"><i class="ri-delete-bin-line text-sm"></i></button>
                        </form>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <!-- ✅ DESKTOP TABLE: All 6 columns -->
    <div class="hidden md:block">
        <table class="w-full text-sm">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-3 py-2.5 text-left text-xs font-semibold text-gray-600">Domain</th>
                    <th class="px-3 py-2.5 text-left text-xs font-semibold text-gray-600">Document Root</th>
                    <th class="px-3 py-2.5 text-left text-xs font-semibold text-gray-600">PHP</th>
                    <th class="px-3 py-2.5 text-left text-xs font-semibold text-gray-600">Status</th>
                    <th class="px-3 py-2.5 text-left text-xs font-semibold text-gray-600">SSL</th>
                    <th class="px-3 py-2.5 text-right text-xs font-semibold text-gray-600">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% websites.forEach(function(site) { %>
                <tr class="border-b border-gray-100 hover:bg-gray-50">
                    <td class="px-3 py-2.5">
                        <a href="/websites/<%= site.id %>" class="font-semibold text-blue-600 hover:text-blue-800 no-underline">
                            <i class="ri-global-line text-blue-500 mr-1"></i> <%= site.domain %>
                        </a>
                    </td>
                    <td class="px-3 py-2.5">
                        <code class="text-gray-500 text-xs truncate block max-w-[200px] cursor-pointer"
                              onclick="this.classList.toggle('truncate'); this.classList.toggle('break-all');"
                              title="<%= site.document_root %>">
                            <%= site.document_root %>
                        </code>
                    </td>
                    <td class="px-3 py-2.5">
                        <span class="bg-sky-100 text-sky-700 text-xs font-medium px-2 py-0.5 rounded-full"><%= site.php_version %></span>
                    </td>
                    <td class="px-3 py-2.5">
                        <% if (site.status === 'active') { %>
                            <span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded-full"><i class="ri-checkbox-blank-circle-fill mr-1"></i>Active</span>
                        <% } else if (site.status === 'suspended') { %>
                            <span class="bg-yellow-100 text-yellow-700 text-xs font-medium px-2 py-0.5 rounded-full"><i class="ri-checkbox-blank-circle-fill mr-1"></i>Suspend</span>
                        <% } else { %>
                            <span class="bg-gray-100 text-gray-700 text-xs font-medium px-2 py-0.5 rounded-full"><i class="ri-checkbox-blank-circle-fill mr-1"></i>Pending</span>
                        <% } %>
                    </td>
                    <td class="px-3 py-2.5">
                        <% if (site.ssl_status === 'active') { %>
                            <span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded-full"><i class="ri-lock-fill mr-1"></i>Active</span>
                        <% } else { %>
                            <span class="bg-gray-100 text-gray-500 text-xs font-medium px-2 py-0.5 rounded-full">None</span>
                        <% } %>
                    </td>
                    <td class="px-3 py-2.5 text-right whitespace-nowrap">
                        <a href="/websites/<%= site.id %>" class="inline-flex items-center justify-center w-7 h-7 border border-blue-300 text-blue-600 rounded hover:bg-blue-50"><i class="ti ti-eye text-sm"></i></a>
                        <% if (site.status === 'active') { %>
                        <form action="/websites/<%= site.id %>/suspend" method="POST" class="inline">
                            <button class="inline-flex items-center justify-center w-7 h-7 border border-yellow-300 text-yellow-600 rounded hover:bg-yellow-50" onclick="event.preventDefault(); confirmDelete(this.closest('form'), 'Suspend this website?')"><i class="ti ti-player-pause text-sm"></i></button>
                        </form>
                        <% } else { %>
                        <form action="/websites/<%= site.id %>/activate" method="POST" class="inline">
                            <button class="inline-flex items-center justify-center w-7 h-7 border border-green-300 text-green-600 rounded hover:bg-green-50"><i class="ri-play-line text-sm"></i></button>
                        </form>
                        <% } %>
                        <form action="/websites/<%= site.id %>/delete" method="POST" class="inline">
                            <button class="inline-flex items-center justify-center w-7 h-7 border border-red-300 text-red-600 rounded hover:bg-red-50" onclick="event.preventDefault(); confirmDelete(this.closest('form'), 'Delete this website? This cannot be undone.')"><i class="ti ti-trash text-sm"></i></button>
                        </form>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>